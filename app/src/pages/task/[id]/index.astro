---
import AppLayout from '../../../layouts/AppLayout.astro';
import TaskPageHeader from '../../../components/TaskPageHeader.astro';
import { getContentIndex, getTask, withBase } from '../../../lib/content';
import { renderMarkdown } from '../../../lib/markdown';

export function getStaticPaths() {
  const { tasks } = getContentIndex();
  return tasks.map((task) => ({ params: { id: task.id } }));
}

const { id } = Astro.params;
const task = getTask(id!);
if (!task) throw new Error(`Task ${id} not found`);

if (!task.hasTheory) {
  if (task.solutions.length > 0) {
    return Astro.redirect(withBase(`/task/${task.id}/template`));
  }
}

const theoryHtml = task.hasTheory ? renderMarkdown(task.theoryMarkdown) : '';
---

<AppLayout title={task.title} description={task.title}>
  {task.hasTheory ? (
    <>
      <TaskPageHeader task={task} active="theory" />

      <label class="checkbox-row">
        <input type="checkbox" data-progress-theory={task.id} />
        Теория изучена
      </label>

      <article class="prose" set:html={theoryHtml} />
    </>
  ) : (
    <>
      <nav class="breadcrumb">
        <a href={withBase('/')}>Учебник</a> / {task.title}
      </nav>
      <h1 class="page-title">{task.title}</h1>
      <p style="color: var(--muted)">Материалы для этого задания пока не добавлены.</p>
      <p>
        <a class="btn" href={task.githubUrl} target="_blank" rel="noopener noreferrer">Открыть на GitHub</a>
      </p>
    </>
  )}
</AppLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.querySelector('[data-progress-theory]') as HTMLInputElement | null;
    if (!input) return;
    const taskId = input.dataset.progressTheory!;
    if (window.EgeProgress?.isTheoryDone(taskId)) input.checked = true;
    input.addEventListener('change', () => {
      window.EgeProgress?.setTheory(taskId, input.checked);
    });
  });
</script>
