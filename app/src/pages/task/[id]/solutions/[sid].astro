---
import { getHighlighter } from '../../../../lib/highlighter';
import AppLayout from '../../../../layouts/AppLayout.astro';
import TaskPageHeader from '../../../../components/TaskPageHeader.astro';
import { getContentIndex, getTask, withBase } from '../../../../lib/content';

export async function getStaticPaths() {
  const { tasks } = getContentIndex();
  const paths = [];
  for (const task of tasks) {
    for (const sol of task.solutions) {
      paths.push({ params: { id: task.id, sid: sol.id } });
    }
  }
  return paths;
}

const { id, sid } = Astro.params;
const task = getTask(id!);
if (!task) throw new Error(`Task ${id} not found`);
const solution = task.solutions.find((s) => s.id === sid);
if (!solution) throw new Error(`Solution ${sid} not found`);

const highlighter = await getHighlighter();
const highlightedLight = highlighter.codeToHtml(solution.code, {
  lang: 'python',
  theme: 'github-light',
});
const highlightedDark = highlighter.codeToHtml(solution.code, {
  lang: 'python',
  theme: 'github-dark',
});
---

<AppLayout title={`${solution.id} — ${task.title}`} description={task.title}>
  <TaskPageHeader task={task} active="template" heading={`${solution.id}.py`}>
    <a slot="breadcrumb" href={withBase(`/task/${task.id}`)}>{task.title}</a>
    {' / '}
    <a href={withBase(`/task/${task.id}/template`)}>Шаблон</a>
    {' / '}
    {solution.id}
  </TaskPageHeader>

  {solution.answer && (
    <div class="answer-badge">Ответ: {solution.answer}</div>
  )}

  <label class="checkbox-row">
    <input type="checkbox" data-progress-solution={`${task.id}/${solution.id}`} />
    Решение просмотрено
  </label>

  {solution.docstring && (
    <div class="docstring">{solution.docstring}</div>
  )}

  <div class="code-block code-block--light" set:html={highlightedLight} />
  <div class="code-block code-block--dark" set:html={highlightedDark} />

  {solution.dataFiles.length > 0 && (
    <section style="margin-top: 1.5rem">
      <h2 style="font-size: 1rem">Файлы данных</h2>
      <ul>
        {solution.dataFiles.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener noreferrer">{f.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p style="margin-top: 1.5rem">
    <a class="btn" href={task.githubUrl} target="_blank" rel="noopener noreferrer">Репозиторий на GitHub</a>
  </p>
</AppLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.querySelector('[data-progress-solution]') as HTMLInputElement | null;
    if (!input) return;
    const key = input.dataset.progressSolution!;
    if (window.EgeProgress?.isSolutionDone(key)) input.checked = true;
    input.addEventListener('change', () => {
      window.EgeProgress?.setSolution(key, input.checked);
      window.EgeProgress?.applySolutionMarks();
    });
  });
</script>
